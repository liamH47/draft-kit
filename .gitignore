# runtime data (DRAFTKIT_DATA_DIR): the SQLite DB and source snapshots.
# A tracked live database is a draft-night hazard — never commit it.
/data/
# Any data dir, not just the default one: a second instance pointed at
# backend/data-friend/ slipped 375MB of snapshots past a literal match.
backend/data/
backend/data-*/

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# node
node_modules/
frontend/dist/

# env
.env

# e2e artifacts
/e2e/screenshots/

# coverage artifacts
.coverage
coverage.xml
htmlcov/
