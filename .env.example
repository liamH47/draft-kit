# Every env var draftkit reads, with its default. Copy to .env to override.

# Where all runtime data lives (SQLite DB + source snapshots).
# Hosting later = mount a volume here.
DRAFTKIT_DATA_DIR=data

# Prod only: path to the built frontend (frontend/dist). When set, the API
# process serves the UI from the same origin. Leave unset in dev (Vite proxies).
#DRAFTKIT_STATIC_DIR=frontend/dist

# Dev only: extra CORS origins, JSON list. Same-origin in prod makes this moot.
#DRAFTKIT_CORS_ORIGINS=["http://localhost:5173"]

# Pin every source read to disk. Set this during a live draft so a lapsed cache
# can never turn a board refresh into a blocking network fetch.
#DRAFTKIT_OFFLINE=1

# Private ESPN leagues only. Copy these two cookie values from your browser
# (DevTools -> Application -> Cookies -> fantasy.espn.com). They are
# credentials: keep them here, and never paste them into a chat, a commit, or
# an issue. Public leagues need neither.
#DRAFTKIT_ESPN_S2=
#DRAFTKIT_ESPN_SWID=

# --- Hosting for friends (all optional; auth is OFF by default) -------------
# Turn on Google sign-in. Requires every field below; the app refuses to boot
# half-configured rather than failing at somebody's first login.
#DRAFTKIT_AUTH=google

# From console.cloud.google.com -> Credentials -> OAuth client ID (Web app).
#DRAFTKIT_GOOGLE_CLIENT_ID=
#DRAFTKIT_GOOGLE_CLIENT_SECRET=

# Signs session cookies. Any long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#DRAFTKIT_SECRET_KEY=

# Who may sign in, comma-separated. Everyone else is turned away by name.
#DRAFTKIT_ALLOWED_EMAILS=you@gmail.com,friend@gmail.com

# ESPN league import runs with YOUR ESPN cookies, so only this email may use
# it. Leave unset to disable ESPN import for everyone on a hosted install.
#DRAFTKIT_OWNER_EMAIL=you@gmail.com

# Where the site lives. The OAuth redirect URI is derived from this
# (<url>/auth/google/callback — register exactly that in the Google console),
# and its scheme decides whether cookies are Secure.
#DRAFTKIT_PUBLIC_URL=https://your-app.fly.dev
